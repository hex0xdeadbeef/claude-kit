{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "_note_alwaysLoad": "Proposal F opt-in (Claude Code v2.1.121+): uncomment the next line to skip ToolSearch deferral. Trade-off: up to 5s cold-start cost + perpetual context tokens. Set CLAUDE_KIT_MCP_PRELOAD=on so mcp-preload-warn.sh verifies the opt-in is wired.",
      "_alwaysLoad_optin": "alwaysLoad: true"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "NO_PROXY": "*",
        "no_proxy": "*",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "http_proxy": "",
        "https_proxy": ""
      }
    },
    "tree_sitter": {
      "command": "uvx",
      "args": [
        "--python",
        "python3.11",
        "mcp-server-tree-sitter"
      ]
    }
  }
}
