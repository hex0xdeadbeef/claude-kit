{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "alwaysLoad": true,
      "_note_alwaysLoad": "Preloads this server at session start. This is static config: alwaysLoad is independent of any env var. CLAUDE_KIT_MCP_PRELOAD itself defaults to off and only governs whether mcp-preload-warn.sh flags drift if this alwaysLoad is ever dropped. Remove this server's alwaysLoad to defer to ToolSearch and save ~5s cold-start + perpetual context tokens."
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "NO_PROXY": "*",
        "no_proxy": "*",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "http_proxy": "",
        "https_proxy": ""
      }
    },
    "tree_sitter": {
      "command": "uvx",
      "args": [
        "--python",
        ">=3.10",
        "--python-preference",
        "only-system",
        "mcp-server-tree-sitter"
      ]
    }
  }
}
