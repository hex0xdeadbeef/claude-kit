{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "alwaysLoad": true,
      "_note_alwaysLoad": "Preloaded to match CLAUDE_KIT_MCP_PRELOAD=on (kit default). Remove this server's alwaysLoad (or set the env off) to defer to ToolSearch and save ~5s cold-start + perpetual context tokens."
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "NO_PROXY": "*",
        "no_proxy": "*",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "http_proxy": "",
        "https_proxy": ""
      }
    },
    "tree_sitter": {
      "command": "uvx",
      "args": [
        "--python",
        "python3.11",
        "mcp-server-tree-sitter"
      ]
    }
  }
}
