{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "TodoWrite",
      "Bash(make *)",
      "Bash(go test *)",
      "Bash(go generate *)",
      "Bash(go list *)",
      "Bash(go build *)",
      "Bash(go fmt *)",
      "Bash(go vet *)",
      "Bash(go mod *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find . -name *)",
      "Bash(find . -type *)",
      "Bash(find . -maxdepth *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(touch *)",
      "Bash(tree *)",
      "Edit(/.claude/skills/workflow-protocols/**)",
      "Edit(/.claude/skills/planner-rules/**)",
      "Edit(/.claude/skills/coder-rules/**)",
      "Edit(/.claude/skills/plan-review-rules/**)",
      "Edit(/.claude/skills/systematic-debugging/**)",
      "Bash(git worktree:*)",
      "Bash(npx markdownlint-cli:*)",
      "Bash(.claude/scripts/tests/*.sh)",
      "Bash(grep -nE '^tools:$' .claude/agents/code-researcher.md)",
      "Bash(grep -c '^## Memory Mechanisms$' CLAUDE.md)",
      "Bash(bash .claude/scripts/tests/test-memory-freshness-warn.sh)",
      "Bash(CLAUDE_HANDOFF_VALIDATION_MODE=strict bash .claude/scripts/validate-handoff.sh .claude/workflow-state/changelog-v2.1.121-141-uplift-handoff.json)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod 0777 *)",
      "Bash(dd if=*)",
      "Bash(mkfs.*)",
      "Bash(truncate *)",
      "Read(.env)",
      "Bash(find * -exec *)",
      "Bash(find * -delete)"
    ],
    "additionalDirectories": [
      "/tmp",
      "/Users/dmitriym/Desktop/claude-kit/.claude/workflow-state"
    ]
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "sequential-thinking",
    "context7",
    "tree_sitter"
  ],
  "hooks": {
    "InstructionsLoaded": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/validate-instructions.sh",
            "args": []
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/protect-files.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-artifact-size.sh",
            "args": [],
            "if": "Write(.claude/**)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/pre-commit-build.sh",
            "args": [],
            "if": "Bash(git commit*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/auto-fmt.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/yaml-lint.sh",
            "args": [],
            "if": "Edit(.claude/**)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Write(.claude/**)"
          },
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Edit(.claude/**)"
          },
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Write(README.md)"
          },
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Edit(README.md)"
          },
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Write(CLAUDE.md)"
          },
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Edit(CLAUDE.md)"
          },
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Write(install.sh)"
          },
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Edit(install.sh)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-plan-drift.sh",
            "args": [],
            "if": "Write(.claude/**)"
          },
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/check-plan-drift.sh",
            "args": [],
            "if": "Edit(.claude/**)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/validate-handoff.sh",
            "args": [],
            "if": "Write(.claude/workflow-state/*-handoff.json)"
          },
          {
            "type": "command",
            "command": ".claude/scripts/validate-handoff.sh",
            "args": [],
            "if": "Edit(.claude/workflow-state/*-handoff.json)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/save-progress-before-compact.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/save-progress-before-compact.sh",
            "args": []
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/verify-state-after-compact.sh",
            "args": []
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "(claude-kit:)?code-researcher",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "code-researcher"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?plan-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".claude/scripts/inject-review-context.sh",
            "args": [
              "plan-reviewer"
            ]
          },
          {
            "type": "command",
            "command": ".claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "plan-reviewer"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".claude/scripts/inject-review-context.sh",
            "args": [
              "code-reviewer"
            ]
          },
          {
            "type": "command",
            "command": ".claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "code-reviewer"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?verdict-recovery",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "verdict-recovery"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(claude-kit:)?(plan-reviewer|code-reviewer|verdict-recovery)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/save-review-checkpoint.sh",
            "args": []
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/enrich-context.sh",
            "args": []
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/agents/meta-agent/scripts/verify-phase-completion.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".claude/scripts/check-uncommitted.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".claude/scripts/notify-workflow-complete.sh",
            "args": []
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/session-analytics.sh",
            "args": []
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/log-stop-failure.sh",
            "args": []
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/notify-user.sh",
            "args": []
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/audit-config-change.sh",
            "args": []
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/log-permission-denied.sh",
            "args": []
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/caveman-activate.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".claude/scripts/mcp-preload-warn.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".claude/scripts/inject-kit-context.sh",
            "args": []
          },
          {
            "type": "command",
            "command": ".claude/scripts/bootstrap-project-config.sh",
            "args": []
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/log-tool-failure.sh",
            "args": []
          }
        ]
      }
    ]
  },
  "worktree": {
    "sparsePaths": [
      ".claude/",
      "internal/",
      "cmd/",
      "go.mod",
      "go.sum",
      "Makefile",
      "CLAUDE.md"
    ],
    "baseRef": "fresh"
  },
  "autoMemoryEnabled": true
}
