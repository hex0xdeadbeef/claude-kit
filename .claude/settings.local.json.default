{
  "env": {
    "GIT_STRIP_CO_AUTHOR": "true",
    "CLAUDE_HANDOFF_VALIDATION_MODE": "strict",
    "CLAUDE_CAVEMAN_MODE": "lite",
    "CLAUDE_VERDICT_VALIDATION_MODE": "strict",
    "CLAUDE_PROJECT_KNOWLEDGE_MODE": "strict",
    "CLAUDE_DELTA_REVIEW_MODE": "strict",
    "CLAUDE_ISSUE_ID_VALIDATION_MODE": "strict",
    "CLAUDE_PK_PATH_MODE": "strict",
    "CLAUDE_KIT_PHASE_COMPLETION_NOTIFY": "on",
    "CLAUDE_KIT_MCP_PRELOAD": "on",
    "CLAUDE_TOOL_FAILURES_MAX_LINES": "1000",
    "ENABLE_PROMPT_CACHING_1H": "1"
  }
}
