{
  "env": {
    "GIT_STRIP_CO_AUTHOR": "true",
    "CLAUDE_HANDOFF_VALIDATION_MODE": "strict",
    "CLAUDE_CAVEMAN_MODE": "lite",
    "CLAUDE_VERDICT_VALIDATION_MODE": "strict",
    "CLAUDE_PROJECT_KNOWLEDGE_MODE": "strict",
    "CLAUDE_DELTA_REVIEW_MODE": "strict",
    "CLAUDE_ISSUE_ID_VALIDATION_MODE": "strict",
    "CLAUDE_PK_PATH_MODE": "strict",
    "CLAUDE_KIT_PHASE_COMPLETION_NOTIFY": "on",
    "CLAUDE_KIT_MCP_PRELOAD": "on",
    "CLAUDE_TOOL_FAILURES_MAX_LINES": "1000",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "TodoWrite",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(jq *)",
      "Bash(git fetch *)",
      "Bash(chmod +x *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git branch -D *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chmod 0777 *)",
      "Bash(dd if=*)",
      "Bash(mkfs.*)",
      "Bash(truncate *)",
      "Bash(shred *)",
      "Bash(find * -exec *)",
      "Bash(find * -delete)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.local)",
      "Write(.env.local)",
      "Read(secrets/**)",
      "Read(**/.ssh/id_*)"
    ]
  }
}
