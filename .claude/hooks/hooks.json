{
  "hooks": {
    "InstructionsLoaded": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/validate-instructions.sh",
            "args": []
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/protect-files.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-artifact-size.sh",
            "args": [],
            "if": "Write(.claude/**)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/pre-commit-build.sh",
            "args": [],
            "if": "Bash(git commit*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/auto-fmt.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/yaml-lint.sh",
            "args": [],
            "if": "Edit(.claude/**)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Write(.claude/**)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Edit(.claude/**)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Write(README.md)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Edit(README.md)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Write(CLAUDE.md)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Edit(CLAUDE.md)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Write(install.sh)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-references.sh",
            "args": [],
            "if": "Edit(install.sh)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-plan-drift.sh",
            "args": [],
            "if": "Write(.claude/**)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/check-plan-drift.sh",
            "args": [],
            "if": "Edit(.claude/**)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/validate-handoff.sh",
            "args": [],
            "if": "Write(.claude/workflow-state/*-handoff.json)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/validate-handoff.sh",
            "args": [],
            "if": "Edit(.claude/workflow-state/*-handoff.json)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/save-progress-before-compact.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/save-progress-before-compact.sh",
            "args": []
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/verify-state-after-compact.sh",
            "args": []
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "(claude-kit:)?(code-researcher|design-critic)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "code-researcher"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?plan-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/inject-review-context.sh",
            "args": [
              "plan-reviewer"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "plan-reviewer"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/inject-review-context.sh",
            "args": [
              "code-reviewer"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "code-reviewer"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?verdict-recovery",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "verdict-recovery"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(claude-kit:)?(plan-reviewer|code-reviewer|verdict-recovery)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/save-review-checkpoint.sh",
            "args": []
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/enrich-context.sh",
            "args": []
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/agents/meta-agent/scripts/verify-phase-completion.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/check-uncommitted.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/notify-workflow-complete.sh",
            "args": []
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/session-analytics.sh",
            "args": []
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/log-stop-failure.sh",
            "args": []
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/notify-user.sh",
            "args": []
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/audit-config-change.sh",
            "args": []
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/log-permission-denied.sh",
            "args": []
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-activate.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/mcp-preload-warn.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/inject-kit-context.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/bootstrap-project-config.sh",
            "args": []
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/log-tool-failure.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
