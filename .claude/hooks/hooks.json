        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/verify-state-after-compact.sh",
            "args": []
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "(claude-kit:)?code-researcher",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "code-researcher"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?plan-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/inject-review-context.sh",
            "args": [
              "plan-reviewer"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "plan-reviewer"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/track-task-lifecycle.sh",
            "args": []
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/inject-review-context.sh",
            "args": [
              "code-reviewer"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "code-reviewer"
            ]
          }
        ]
      },
      {
        "matcher": "(claude-kit:)?verdict-recovery",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/caveman-suspend-for-reviewer.sh",
            "args": [
              "verdict-recovery"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(claude-kit:)?(plan-reviewer|code-reviewer|verdict-recovery)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/.claude/scripts/save-review-checkpoint.sh",
            "args": []
